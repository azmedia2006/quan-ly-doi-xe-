      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "pg_database_size_bytes{datname=\"fleetdb\"}",
          "legendFormat": "Database Size",
          "range": true,
          "refId": "A"
        }
